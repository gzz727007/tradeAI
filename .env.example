# ========================
# LLM API 配置
# ========================

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# 通义千问 Qwen API (OpenAI 兼容接口)
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen2.5-72b-instruct

# DeepSeek API (备用)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ========================
# 消息推送配置 (可选)
# ========================
FEISHU_WEBHOOK_URL=
SERVERCHAN_KEY=

# ========================
# API 访问安全 (部署到公网/局域网时建议开启)
# ========================
# 留空 = 本地模式不鉴权 (默认)；
# 设置后所有 /api/* 请求必须携带 X-API-Token 请求头，WebSocket 通过 ?token= 携带。
# 前端在浏览器控制台执行: localStorage.setItem('TRADEAI_API_TOKEN', '你的token') 后刷新页面。
API_TOKEN=

# 允许的跨域来源 (逗号分隔)。生产环境 SPA 与后端同源托管，通常保持默认即可。
# 本地 Vite 热更新开发 (localhost:3000) 已包含在默认值中。
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
